# ── mihomo 配置模板（可提交）────────────────────────────
# 复制成 mihomo.local.env 后填入真实值：
#     cp mihomo.env.example mihomo.local.env && chmod 600 mihomo.local.env
MIHOMO_SECRET=<openssl rand -hex 16 生成>
MIHOMO_VERSION=v1.19.30
# 机场订阅链接（Clash 格式）。🔴 含 token，泄漏等于别人白嫖你的流量
SUB_URL_A=https://<机场域名>/s/<token>?clash=1
