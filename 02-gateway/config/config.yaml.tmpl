# ─────────────────────────────────────────────────────────────
# mihomo 配置模板
#   渲染：${...} 占位符由 mihomo.local.env 提供
#   部署：/etc/mihomo/config.yaml，权限 600
#   校验：sudo mihomo -t -d /etc/mihomo
# ─────────────────────────────────────────────────────────────

mixed-port: 7890          # HTTP 与 SOCKS5 共用一个端口
allow-lan: true           # 允许局域网其他机器连过来 —— 旁路由必须开
bind-address: '*'
mode: rule
log-level: info

# 🔴 这台机器【只做转发】，处理的是别的设备发来的流量 ——
#    进程归属查询在本机永远查不到对应进程（进程在别的机器上），
#    却要为【每一条连接】付出一次查表开销。off 直接省掉这笔。
#    代价：面板里看不到本机发起连接的进程名 —— 而网关上几乎没有本机连接。
find-process-mode: off

# 对解析出多个 IP 的域名【并发】发起握手，取最先成功的那条。
# 直接降低连接建立延迟，尤其是那些解析出一堆 IP、其中部分不可达的境外域名。
tcp-concurrent: true

# 🔴 关掉 mihomo 自身的 IPv6，两个作用：
#   1. 拉订阅时走 IPv4，命中机场的 IP 白名单
#      （默认按 RFC 6724 优先 IPv6，会带着 240e:... 出去被 403 拒绝）
#   2. DNS 不返回 AAAA，客户端不会尝试 IPv6 直连绕过代理
#      —— 从源头消除分流泄漏
# 代价：只有 IPv6 的站点访问不了，极少见。
ipv6: false

# RESTful 控制接口。热重载与 Web 面板都靠它
external-controller: 0.0.0.0:9090
# 🔴 必须设，否则局域网内任何人都能改配置、看全部连接
secret: "${MIHOMO_SECRET}"
# 面板静态文件。external-ui 在【启动时】注册路由，改了要 restart
external-ui: /etc/mihomo/ui

# 🔴 selector 的手动选择默认【只存在内存里】，重启就回到第一个候选。
#    开这个才会持久化到 cache.db，重启后保持你在面板上选的节点。
profile:
  store-selected: true
  # 🔴 把 fake-ip 映射表持久化到 cache.db。
  #    不开的话，mihomo 一重启或热重载，映射表就清空 ——
  #    而客户端还缓存着旧的 198.18.x.x，发过来时 mihomo 反查不到域名，
  #    日志里就是 "[UDP] Resolve Ip error: can't resolve ip"，连接【直接失败】。
  #    实测这类错误 24 小时内出现过 90 次。
  store-fake-ip: true

# ── GeoIP / Geosite 数据库来源 ────────────────────────────
# 🔴 必须显式指定。mihomo 默认用 raw.githubusercontent.com，
#    该域名在国内直连和走代理都被重置 —— 结果是 GEOIP 规则初始化失败，
#    mihomo 直接 fatal 退出，配合 Restart=always 变成无限重启循环。
#    实测下载速度：jsdelivr cdn 1.8MB/s > testingcf 572KB/s
#                  >> GitHub Release 27KB/s >> raw.githubusercontent 不可达
geo-auto-update: true
geo-update-interval: 12        # 小时
geox-url:
  geoip:   "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geoip.dat"
  mmdb:    "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/country.mmdb"
  geosite: "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geosite.dat"
  asn:     "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/GeoLite2-ASN.mmdb"

# ── TUN：接管流量的核心 ───────────────────────────────────
tun:
  enable: true
  # mixed = TCP 走内核栈（快）+ UDP 走 gvisor（兼容好）。
  # 二进制启动日志里的 "Use tags: with_gvisor" 说明支持这个栈。
  stack: mixed
  device: mihomo-tun
  # 改本机路由表，接管【本机自己发出的】流量（OUTPUT 链）
  auto-route: true
  # 🔴 写 nftables 规则，接管【转发流量】（FORWARD 链）——
  #    旁路由能成立全靠它。别的机器把网关指过来，那些包目标不是本机，
  #    auto-route 改的路由表管不到。
  auto-redirect: true
  auto-detect-interface: true
  # 劫持所有发往 53 端口的查询 —— 客户端就算手动设了 8.8.8.8 也绕不过
  dns-hijack:
    - any:53
  mtu: 1500
  # 🔴 不开 strict-route：它会强制一切流量进 TUN，包括 SSH，
  #    远程操作时有失联风险。auto-redirect 已经覆盖了旁路由所需的场景。
  strict-route: false

# ── DNS ───────────────────────────────────────────────────
dns:
  enable: true
  listen: 0.0.0.0:53
  ipv6: false
  # fake-ip：海外域名不做真实解析，直接返回假 IP，
  # 客户端往假 IP 发包进 TUN，mihomo 反查还原出域名。
  # 这样 GEOSITE / DOMAIN 规则在 TUN 模式下才可用，且从机制上免疫 DNS 污染。
  enhanced-mode: fake-ip
  # 198.18.0.0/15 是 RFC 2544 的基准测试保留段，不会与真实地址冲突
  fake-ip-range: 198.18.0.1/16

  # 🔴 这些【不做】fake-ip，必须返回真实 IP。
  #
  # 语法限制：只支持 '*.' 前缀（匹配一级）和 '+.' 后缀（自身及所有子域），
  # 【不支持】'time.*.com' 这种中间通配，也不支持 'vm-*' 这种尾部通配 ——
  # 写了会报 invalid domain，配置直接校验不过。
  fake-ip-filter:
    - '*.lan'
    - '*.local'
    - '*.localdomain'
    - '+.home'                          # 光猫的 zte.home
    - '+.direct'
    # 🔴 代理服务器自身的域名必须返回真实 IP，否则会绕路
    - '${SELF_SERVER}'
    # 网络连通性检测：拿到假 IP 会被误判成"无网络"
    - '+.msftconnecttest.com'
    - '+.msftncsi.com'
    - 'connectivity-check.ubuntu.com'
    - 'captive.apple.com'
    # 需要真实 IP 的服务
    - 'localhost.ptlogin2.qq.com'
    - '+.pool.ntp.org'
    - 'ntp.aliyun.com'
    - 'time.windows.com'
    - 'time.apple.com'
    - '+.time.edu.cn'

  # 解析下面 nameserver 里域名用的引导 DNS
  default-nameserver: [223.5.5.5, 119.29.29.29]
  # 国内域名用这些真解析。海外域名压根不解析，所以不需要配境外 DNS
  nameserver: [223.5.5.5, 119.29.29.29]
  # 🔴 解析【代理服务器自身】的域名，必须直连，否则鸡生蛋
  proxy-server-nameserver: [223.5.5.5]

  # 🔴 内网域名必须转给光猫解析。
  #    它们在 fake-ip-filter 里（不做假 IP），但公共 DNS 不认识 zte.home 这类
  #    光猫自己注册的名字 —— 不加这条会解析不出来。
  nameserver-policy:
    '+.home': [192.168.5.1]
    '*.lan': [192.168.5.1]
    '*.local': [192.168.5.1]
    '*.localdomain': [192.168.5.1]

# ── 自建节点（AI 专用线路）────────────────────────────────
# 与订阅并存，互不干扰。同一台 VPS 的两个协议端口，
# fallback 只能防「单协议被识别阻断」，防不了「服务器宕机」。
proxies:
  - name: Trojan-3xUI
    type: trojan
    server: ${SELF_SERVER}
    port: 9444
    password: ${SELF_TROJAN_PASSWORD}
    sni: ${SELF_SERVER}
    skip-cert-verify: false
    udp: true

  - name: VMess-3xUI
    type: vmess
    server: ${SELF_SERVER}
    port: 9445
    uuid: ${SELF_VMESS_UUID}
    alterId: 0                      # Surge 的 vmess-aead=true 对应 alterId: 0
    cipher: auto
    tls: true
    servername: ${SELF_SERVER}
    skip-cert-verify: false
    udp: true

# ── 订阅节点来源 ──────────────────────────────────────────
proxy-providers:
  airport-a:
    type: http
    url: "${SUB_URL_A}"
    # 拉下来缓存到这（相对 -d /etc/mihomo）。拉取失败时继续用旧缓存，
    # 所以订阅出问题不会导致 mihomo 起不来
    path: ./providers/airport-a.yaml
    interval: 86400                 # 自动更新间隔，秒
    health-check:
      enable: true                  # url-test 类型的策略组必须有它
      url: https://www.gstatic.com/generate_204
      interval: 300

# ── 策略组 ────────────────────────────────────────────────
proxy-groups:
  # 自建线路：Trojan 优先，不健康时切 VMess。
  # 🔴 fallback 只在【当前节点不健康】时切换，不会因延迟波动而切 —— 出口 IP 稳定。
  - name: 自建线路
    type: fallback
    proxies:
      - Trojan-3xUI
      - VMess-3xUI
    url: https://www.gstatic.com/generate_204
    interval: 180
    # 🔴 lazy 默认 true：组未被使用时不做健康检查。
    #    结果是启动瞬间没有健康数据，fallback 会选错候选，
    #    要等 interval 到期才自愈。实测启动后 5 分钟内通用流量全走了自建节点。
    lazy: false

  # 🔴 AI 服务：只走自建线路，【绝不切换到订阅节点】。
  #    自建两个协议都不健康时 → REJECT，连接立刻被拒。
  #    这是刻意的：快速失败比连接超时转圈半天好，你能立刻知道出了问题。
  - name: AI服务
    type: fallback
    proxies:
      - 自建线路
      - REJECT
    url: https://www.gstatic.com/generate_204
    interval: 180
    # 🔴 lazy 默认 true：组未被使用时不做健康检查。
    #    结果是启动瞬间没有健康数据，fallback 会选错候选，
    #    要等 interval 到期才自愈。实测启动后 5 分钟内通用流量全走了自建节点。
    lazy: false

  # ── GitHub ────────────────────────────────────────────────
  # 🔴 为什么单独建组而不并进 AI服务：两者候选完全相同（都是
  #    [自建线路, REJECT]），行为没有区别 —— 单独建组是为了【日志和面板里
  #    能把 GitHub 流量与 AI 流量分开看】，排查时不至于混成一片。
  #
  # 🔴 为什么用 REJECT 收尾而不退回订阅：和 AI 同一条原则 —— 宁可显性失败，
  #    不要静默换出口。GitHub 本身不涉及账号风险（用订阅只是慢），但保持
  #    "所有必须走自建的流量、失败方式一致"，心智模型更简单。
  #
  # 归入本组的理由：GitHub 是 AI agent 依赖链的一部分（安装、更新、拉依赖），
  # 走固定独享 IP 比走多人共享且会漂移的订阅节点稳定得多。
  - name: GitHub
    type: fallback
    proxies:
      - 自建线路
      - REJECT
    url: https://www.gstatic.com/generate_204
    interval: 180
    lazy: false

  # 订阅线路：按 provider 里的顺序取第一个健康的。
  # 节点失败会自动切下一个，但健康时一直用同一个 —— 不按延迟动态切换。
  - name: 订阅线路
    type: fallback
    use: [airport-a]
    url: https://www.gstatic.com/generate_204
    interval: 300
    lazy: false

  # 通用出口：订阅【全部】节点不可用时转自建线路；自建也挂 → REJECT。
  # 🔴 最后一级是 REJECT 而不是 DIRECT，理由同 AI服务：
  #    连接立刻被拒（快速失败），你马上知道出问题了；
  #    退回 DIRECT 会变成「能上网但没代理」的隐性故障，察觉不到。
  - name: 通用出口
    type: fallback
    proxies:
      - 订阅线路
      - 自建线路
      - REJECT
    url: https://www.gstatic.com/generate_204
    interval: 300
    lazy: false

  # 通用流量的落点。所有非 AI、非国内的流量走这里。
  # select 类型：默认用通用出口，需要时可在面板上手动固定任意节点。
  - name: PROXY
    type: select
    proxies:
      - 通用出口
      - 订阅线路
      - 自建线路
      - DIRECT
    use: [airport-a]                # 39 个节点也列为候选，可手动固定

# ── 规则（顺序匹配，第一条命中即停）────────────────────────
rules:
  # ── ① 代理服务器自身：必须直连 ──────────────────────────
  # 🔴 这条不是优化，是防「代理套代理」。局域网设备（例如 Mac 上常开的 Surge）
  #    去连自建服务器时，包一定先到 mihomo —— 它是全网关，绕不过去。
  #    若不显式放行，就会落到最后的 MATCH,PROXY：
  #        Surge 的隧道 → 再被订阅节点套一层 → 延迟叠加 + 订阅流量按倍率白扣
  #    实测抓到过 update.code.visualstudio.com 走 [Lv3·2.0x] 节点，双倍计费。
  #
  # 🔴 加这条之前，它是【靠巧合】走对的：自建服务器用的是 .cn 域名，
  #    碰巧命中下面的 GEOSITE,cn,DIRECT（该类别包含整个 .cn 顶级域）。
  #    一旦换成 .com / .net 域名立刻破功，而且【不报任何错】，极难发现。
  - DOMAIN,${SELF_SERVER},DIRECT
  # IP 维度双保险：客户端自带 DNS（Surge 的 fake-ip、DoH、写死 IP 的 App）
  # 不经过 mihomo 解析，这时只能按目标 IP 命中。
  # no-resolve = 不为这条规则触发 DNS 解析（本来就是纯 IP，解析无意义还拖慢）。
  # 🔴 换 VPS / 换 IP 后必须同步改 mihomo.local.env 里的 SELF_SERVER_IP。
  - IP-CIDR,${SELF_SERVER_IP}/32,DIRECT,no-resolve

  # ── ② AI 服务（最高优先级，只走自建线路，失败即 REJECT）──
